ENTRY(mzOverlayHeader)
/* 30912 bytes measured in de119c0 with -Os; keep 32 KiB below
 * the existing 0xD0000 low-memory ceiling. Never extend into game RAM. */
MEMORY { ovl : ORIGIN = 0x000C8000, LENGTH = 32K }
PHDRS { image PT_LOAD; }
SECTIONS {
 .text : { KEEP(*(.mzovl.hdr)) *(.text .text.* .gnu.linkonce.t*) } >ovl :image
 .rodata ALIGN(16) : { *(.rodata .rodata.* .rdata .gnu.linkonce.r*) } >ovl :image
 .data ALIGN(16) : { *(.data .data.* .sdata .sdata.* .got) } >ovl :image
 .bss ALIGN(64) (NOLOAD) : { *(.bss .bss.* .sbss .sbss.*) *(COMMON) . = ALIGN(16); } >ovl :image
 _mz_overlay_end = .;
 /DISCARD/ : { *(.reginfo) *(.MIPS.abiflags) *(.comment) *(.pdr) *(.mdebug.*) *(.gnu.attributes) *(.eh_frame) }
 ASSERT(mzOverlayHeader == ORIGIN(ovl), "MAIZO: overlay header must start at reserved base")
 ASSERT(_mz_overlay_end <= ORIGIN(ovl) + LENGTH(ovl), "MAIZO: separate overlay exceeds reserved arena")
}
